# Copie ce fichier en « .env » (même dossier) et remplis les deux lignes.
# Ne partage JAMAIS ce fichier : il contient le token de ton bot.

# Token donné par @BotFather sur Telegram (ex. 123456789:AA...)
TELEGRAM_BOT_TOKEN=

# Ton identifiant de chat : laisse vide au premier lancement, envoie /start à ton bot,
# il te répondra avec le nombre à coller ici, puis relance le programme.
TELEGRAM_CHAT_ID=

# 1 = affiche les alertes dans la fenêtre au lieu de les envoyer (test)
DRY_RUN=0
