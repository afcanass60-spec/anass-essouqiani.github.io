# Image unique pour l'hébergement (Render, Railway, Fly…) : frontend Next.js + API FastAPI dans un conteneur.
# Le frontend écoute sur $PORT (public) et relaie /api vers l'API, joignable uniquement en local (127.0.0.1:8000).

FROM node:22-bookworm-slim AS web
WORKDIR /web
ENV NEXT_TELEMETRY_DISABLED=1
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
RUN npm run build

FROM python:3.13-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 \
    NEXT_TELEMETRY_DISABLED=1 NODE_ENV=production HOSTNAME=0.0.0.0 \
    BACKEND_URL=http://127.0.0.1:8000 STORAGE_DIR=/app/storage
RUN apt-get update \
    && apt-get install -y --no-install-recommends libpango-1.0-0 libpangoft2-1.0-0 shared-mime-info fonts-dejavu-core \
    && for pkg in libharfbuzz-subset0 fonts-inter fonts-ibm-plex fonts-lato fonts-open-sans fonts-roboto-unhinted fonts-roboto; do \
         apt-get install -y --no-install-recommends "$pkg" || echo "Paquet optionnel indisponible : $pkg"; \
       done \
    && rm -rf /var/lib/apt/lists/*
COPY --from=web /usr/local/bin/node /usr/local/bin/node

WORKDIR /app
COPY backend/requirements.txt .
RUN pip install -r requirements.txt
COPY backend/app ./app
COPY --from=web /web/.next/standalone /web
COPY --from=web /web/.next/static /web/.next/static
COPY --from=web /web/public /web/public
COPY scripts/start-all.sh /start-all.sh
RUN useradd --create-home --uid 10001 app && mkdir -p /app/storage && chown -R app:app /app /web && chmod +x /start-all.sh
USER app
EXPOSE 10000
CMD ["/start-all.sh"]
