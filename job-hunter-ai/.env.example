# ============================================================
# Job Hunter AI — configuration (copier en .env, ne JAMAIS committer .env)
# ============================================================

# --- Application / sécurité (OBLIGATOIRE en production) ---
ENVIRONMENT=production
# python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=
# python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
POSTGRES_PASSWORD=
FRONTEND_ORIGIN=http://localhost:3000
# true derrière HTTPS (reverse proxy)
COOKIE_SECURE=false
ALLOW_REGISTRATION=false
LOG_LEVEL=INFO

# --- IA : Claude (https://console.anthropic.com) ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium
LLM_SCORING_ENABLED=true
# l'IA n'affine que les offres dont le score déterministe dépasse ce seuil (maîtrise des coûts)
LLM_SCORING_MIN_RULE_SCORE=45

# --- Sources d'offres officielles ---
# France Travail : https://francetravail.io -> créer une application -> API « Offres d'emploi v2 »
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=
# La Bonne Alternance / API apprentissage : https://api.apprentissage.beta.gouv.fr
LBA_API_TOKEN=
# Adzuna : https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Google Programmable Search (optionnel) : https://programmablesearchengine.google.com
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=

# --- Temps de trajet réels ---
# Île-de-France Mobilités PRIM (Navitia) : https://prim.iledefrance-mobilites.fr
PRIM_API_KEY=
# OpenRouteService (voiture) : https://openrouteservice.org/dev
OPENROUTESERVICE_API_KEY=

# --- Alertes email (LinkedIn, Indeed, WTTJ, Apec, HelloWork, JobTeaser…) : lecture IMAP seule ---
# Conseil : boîte/dossier dédié aux alertes + mot de passe d'application
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# --- Notifications / envoi (optionnel) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFY_EMAIL_TO=
# ex : https://ntfy.sh/un-sujet-long-et-secret
NOTIFY_WEBHOOK_URL=
