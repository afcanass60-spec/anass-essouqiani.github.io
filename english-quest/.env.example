# ---------------------------------------------------------------
# English Quest — variables d'environnement
# Copiez ce fichier en .env.local puis renseignez les valeurs.
# Aucune variable n'est obligatoire : sans elles, l'application
# fonctionne en mode local et les fonctions IA sont désactivées.
# ---------------------------------------------------------------

# --- Supabase (comptes, synchronisation, classement) ---
# Projet Supabase > Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Intelligence artificielle (serveur uniquement, jamais exposée au navigateur) ---
# Option 1 : Claude (Anthropic)
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Modèle (facultatif). Par défaut : claude-opus-5-5
# AI_MODEL=claude-opus-5-5

# Option 2 : toute API compatible OpenAI /chat/completions
# (OpenAI, Mistral, Groq, OpenRouter… ou Ollama, gratuit en local)
# AI_PROVIDER=openai-compatible
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=llama3.1
# AI_API_KEY=

# Si Supabase est configuré, l'IA est réservée aux utilisateurs connectés.
# Mettre à true pour l'autoriser aux visiteurs (déconseillé en production).
# AI_ALLOW_ANONYMOUS=false

# Nombre de requêtes IA par minute et par utilisateur (défaut : 20)
# AI_RATE_LIMIT_PER_MINUTE=20
